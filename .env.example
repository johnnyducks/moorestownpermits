# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. All are server-side only:
# never prefix them with NEXT_PUBLIC_.

# ─── Storage ───────────────────────────────────────────────────────────────────
# Postgres connection string. Required on Vercel (add Neon from the Vercel
# Marketplace and it sets DATABASE_URL for you, or paste a Supabase URL).
# Locally, leave empty to keep applications in ./.data/applications.json.
DATABASE_URL=

# ─── Staff console ─────────────────────────────────────────────────────────────
# Reviewers sign in with this key. Without it the console is open in
# development and turned off in production.
STAFF_ACCESS_KEY=

# Signs the applicant and staff cookies. Recommended on Vercel; generate with
#   openssl rand -hex 32
SESSION_SECRET=

# ─── OpenAI ────────────────────────────────────────────────────────────────────
# Homeowner Q&A, and the written part of the staff review.
OPENAI_API_KEY=
# Optional. Default gpt-5.
OPENAI_MODEL=

# ─── Jev (decision classifier) ─────────────────────────────────────────────────
# Makes the staff review's routing call and completeness score, with
# calibrated probabilities.
JEV_API_KEY=
# Optional. Defaults: jev-latest, https://api.typesafe.ai
JEV_MODEL=
JEV_API_BASE=
